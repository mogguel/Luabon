-- Toggle + Keybind factory
local function CreateToggle(parent, text, y, settingKey, default)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, 0, 0, 38)
    frame.Position = UDim2.new(0, 0, 0, y)
    frame.BackgroundColor3 = Color3.fromRGB(26, 12, 18)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 9)

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(0.55, 0, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(240, 220, 200)
    label.Font = Enum.Font.Gotham
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left

    -- Keybind box
    local keyBox = Instance.new("TextButton", frame)
    keyBox.Size = UDim2.new(0, 36, 0, 24)
    keyBox.Position = UDim2.new(1, -100, 0.5, -12)
    keyBox.BackgroundColor3 = Color3.fromRGB(40, 22, 28)
    keyBox.Text = "—"
    keyBox.TextColor3 = Color3.fromRGB(180, 180, 180)
    keyBox.Font = Enum.Font.GothamBold
    keyBox.TextSize = 12
    Instance.new("UICorner", keyBox).CornerRadius = UDim.new(0, 6)

    keyBox.MouseButton1Click:Connect(function()
        keyBox.Text = "..."
        WaitingForKey = settingKey
    end)

    -- ON/OFF
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0, 52, 0, 24)
    btn.Position = UDim2.new(1, -58, 0.5, -12)
    btn.BackgroundColor3 = default and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(50, 28, 34)
    btn.Text = default and "ON" or "OFF"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local state = default
    S[settingKey] = default

    local function SetState(v)
        state = v
        S[settingKey] = v
        btn.Text = v and "ON" or "OFF"
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = v and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(50, 28, 34)
        }):Play()
    end

    btn.MouseButton1Click:Connect(function()
        SetState(not state)
    end)

    -- Update keybind display
    task.spawn(function()
        while task.wait(0.2) do
            if Keybinds[settingKey] then
                keyBox.Text = Keybinds[settingKey].Name
            end
        end
    end)

    return SetState
end

