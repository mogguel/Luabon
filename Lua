UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    -- Reopen menu
    if input.KeyCode == Enum.KeyCode.RightShift then
        GuiVisible = not GuiVisible
        Main.Visible = GuiVisible
        return
    end

    -- Setting keybind
    if WaitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then
        Keybinds[WaitingForKey] = input.KeyCode
        WaitingForKey = nil
        return
    end

    -- Toggle by keybind
    for setting, key in pairs(Keybinds) do
        if key and input.KeyCode == key then
            S[setting] = not S[setting]
        end
    end
end)

-- ==================== 3D UMBRELLA ====================
local function MakeUmbrella(head)
    if head:FindFirstChild("FindMyUmbrella") then
        head.FindMyUmbrella:Destroy()
    end

    local model = Instance.new("Model")
    model.Name = "FindMyUmbrella"
    model.Parent = head

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.15, 1.4, 0.15)
    handle.Color = Color3.fromRGB(40, 40, 40)
    handle.Material = Enum.Material.SmoothPlastic
    handle.Anchored = false
    handle.CanCollide = false
    handle.Parent = model

    local top = Instance.new("Part")
    top.Name = "Top"
    top.Size = Vector3.new(2.2, 0.35, 2.2)
    top.Color = Color3.fromRGB(0, 255, 110)
    top.Material = Enum.Material.Neon
    top.Anchored = false
    top.CanCollide = false
    top.Parent = model

    local mesh = Instance.new("SpecialMesh", top)
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale = Vector3.new(1, 0.35, 1)

    local weld1 = Instance.new("Weld")
    weld1.Part0 = head
    weld1.Part1 = handle
    weld1.C0 = CFrame.new(0, 2.1, 0)
    weld1.Parent = handle

    local weld2 = Instance.new("Weld")
    weld2.Part0 = handle
    weld2.Part1 = top
    weld2.C0 = CFrame.new(0, 0.75, 0)
    weld2.Parent = top

    return model
end

